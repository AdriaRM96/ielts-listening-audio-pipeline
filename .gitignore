# Secrets & credentials — never commit
.env
.env.*
!.env.example
# Blanket JSON exclude: GCP service-account keys have no fixed naming
# convention — the console's own default download is
# <project-id>-<random-hash>.json, which no filename-pattern glob reliably
# catches. Nothing in this repo needs a tracked .json file (checked via
# `git ls-files | grep json` — empty), so there's no exception to carve out.
*.json
*.pem

# Generated audio output (voice/topic rotation state is *.json, already
# covered by the blanket exclude above)
output/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# OS
.DS_Store

# Local Claude Code workflow config — not part of the published project
.claude/
